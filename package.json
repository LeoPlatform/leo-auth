{
  "name": "auth",
  "version": "2.0.0",
  "description": "This is a sample BOT Description",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "mocha --recursive -w --require ./test/bootstrap.js",
    "start": "leo test ."
  },
  "config": {
    "leo": {
      "type": "microservice",
      "name": "Leo_Auth",
      "restApiId": {
        "ref": "auth.restapi"
      },
      "aws": {
        "role": {
          "ref": "auth.roles.LeoAuthRole"
        }
      },
      "regions": [
        "us-west-2",
        "us-east-1"
      ],
      "runtime": "nodejs26.x",
      "no_env_param": true,
      "3rdParty": true,
      "excludeProfiles": true
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1022.0",
    "@aws-sdk/lib-dynamodb": "^3.1022.0",
    "@aws-sdk/util-dynamodb": "^3.996.0",
    "async": "^3.0.1",
    "leo-auth": "4.0.8-awsv3node26.1",
    "leo-config": "1.1.0"
  }
}
